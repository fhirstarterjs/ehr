{
   "name": "@fhirstarter/ehr",
   "version": "1.1.3",
   "description": "Thin, plug-and-play SMART on FHIR EHR-launch library with no runtime deps. Runs native SMART App Launch in the background with live progress and turnkey Vue/React components, then hands off a flat authorized result for any FHIR library.",
   "license": "Kopimi",
   "author": "Joshua Faulkenberry <j@joshuafaulkenberry.com> (https://joshuafaulkenberry.com/)",
   "keywords": [
      "fhir",
      "smart-on-fhir",
      "smart-app-launch",
      "ehr",
      "fhirclient",
      "oauth2",
      "vue",
      "react"
   ],
   "repository": {
      "type": "git",
      "url": "git+https://github.com/fhirstarterjs/ehr.git"
   },
   "homepage": "https://github.com/fhirstarterjs/ehr#readme",
   "bugs": "https://github.com/fhirstarterjs/ehr/issues",
   "type": "module",
   "publishConfig": {
      "access": "public"
   },
   "sideEffects": [
      "**/*.css"
   ],
   "engines": {
      "node": ">=20.19"
   },
   "exports": {
      ".": {
         "types": "./dist/ts/index.d.ts",
         "import": "./dist/index.js"
      },
      "./vue": {
         "types": "./dist/ui/vue/index.d.ts",
         "import": "./dist/vue.js"
      },
      "./react": {
         "types": "./dist/ui/react/index.d.ts",
         "import": "./dist/react.js"
      },
      "./style.css": "./dist/style.css"
   },
   "files": [
      "dist/*.js",
      "dist/*.js.map",
      "dist/*.css",
      "dist/ts/index.d.ts",
      "dist/ts/progress.d.ts",
      "dist/ts/status.d.ts",
      "dist/ui/react/index.d.ts",
      "dist/ui/react/LaunchModal.d.ts",
      "dist/ui/react/EhrLaunch.d.ts",
      "dist/ui/vue/index.d.ts",
      "types/core.d.ts",
      "types/native.d.ts",
      "types/assets.d.ts",
      "types/vue-shim.d.ts",
      "README.md",
      "LICENSE.md"
   ],
   "scripts": {
      "check": "tsc --noEmit",
      "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && vite build && node scripts/inline-css.mjs && tsc && node scripts/link-types.mjs",
      "prepare": "npm run build",
      "prepack": "npm run build"
   },
   "peerDependencies": {
      "react": ">=19 <20",
      "vue": ">=3.5 <4"
   },
   "peerDependenciesMeta": {
      "react": {
         "optional": true
      },
      "vue": {
         "optional": true
      }
   },
   "devDependencies": {
      "@types/node": "^26.1.2",
      "@types/react": "^19.2.18",
      "@vitejs/plugin-react": "^6.0.5",
      "@vitejs/plugin-vue": "^6.0.8",
      "react": "^19.2.8",
      "sass": "^1.102.0",
      "typescript": "~7.0.2",
      "vite": "^8.2.0",
      "vue": "^3.5.40"
   },
   "overrides": {
      "uuid": "^11.1.1"
   }
}
